# Gemini Live API (Required for Real-time Voice)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.8-live
TEXT_MODEL_NAME=gemini-3.5-flash

# OpenRouter (Optional: DeepSeek-v4 reasoning for Question Generation & Grading)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# Notion Integration (Optional: To sync articles from Notion database)
NOTION_API_TOKEN=your_notion_integration_token_here
NOTION_DATASOURCE_ID=your_notion_database_or_datasource_id_here

# Database Configuration (Optional: Defaults to local SQLite retain_ai.db if empty)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Server Configuration
HOST=0.0.0.0
PORT=8080

